<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot parent provides dependency management and plugin versions -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- Spring Boot 3.3.x is the latest release line compatible with Java 17+ -->
        <version>3.3.6</version>
        <relativePath/>
    </parent>

    <groupId>com.transitandtile</groupId>
    <artifactId>transit-and-tile</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>transit-and-tile</name>
    <description>Transit and Tile — Hotel Booking Portal</description>

    <properties>
        <!-- Lock the Java version to 17 as required by the project spec -->
        <java.version>17</java.version>
    </properties>

    <dependencies>

        <!-- Spring Web: REST controller support, Jackson JSON serialization -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Data JPA + Hibernate: entity mapping and repository support -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Bean Validation (Jakarta): @NotBlank, @Email, @NotNull etc. on request DTOs -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- MySQL JDBC driver: connects to the local MySQL 8 instance -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Spring Boot Test: JUnit 5 + Mockito + Spring context support for tests -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            H2 in-memory database: used ONLY for the application context smoke test
            so that `mvn test` passes without a live MySQL connection.
            H2 does NOT replicate MySQL/InnoDB locking semantics. All real
            integration tests (overlap, concurrency, transactions) must target MySQL.
        -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!-- Spring Boot Maven plugin: creates executable jar and supports mvn spring-boot:run -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
